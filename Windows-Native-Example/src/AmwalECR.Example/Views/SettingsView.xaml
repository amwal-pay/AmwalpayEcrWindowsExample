<UserControl x:Class="AmwalECR.Example.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AmwalECR.Example.Ui.Behaviors"
             IsTabStop="False">
    <!--
        DataContext: SettingsViewModel. The environment and both signing keys - the
        port of EnvironmentSelector. Every change is saved at once (encrypted with
        Windows DPAPI for this user); there is no Save button.
    -->
    <StackPanel>
        <Border Style="{StaticResource Card}"
                Margin="0,0,0,12"
                Background="{StaticResource ErrorContainerBrush}"
                Visibility="{Binding Notice, Converter={StaticResource StringToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}"
                       Foreground="{StaticResource ErrorBrush}"
                       Text="{Binding Notice}"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Wi-Fi / LAN. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}"
                           Text="Wi&#x2011;Fi / LAN settings"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="0,4,0,12"
                           Text="Signing key for Wi&#x2011;Fi, USB cable, and Bluetooth ECR (sorted key=value HMAC)." />

                <Label Content="Wi-Fi/LAN secure hash _key" Target="{Binding ElementName=WifiKeyMasked}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="WifiKeyMasked"
                                     Style="{StaticResource FieldPasswordBox}"
                                     ui:PasswordBoxBinding.Filter="Hex"
                                     ui:PasswordBoxBinding.BoundPassword="{Binding WifiSecureHashKey, Mode=TwoWay}"
                                     ui:FieldState.HasError="{Binding HasWifiKeyError}"
                                     Visibility="{Binding ShowWifiKey, Converter={StaticResource InverseBoolToVisibility}}"
                                     AutomationProperties.Name="Wi-Fi/LAN secure hash key" />
                        <TextBox x:Name="WifiKeyPlain"
                                 Style="{StaticResource FieldTextBox}"
                                 FontFamily="Consolas"
                                 ui:TextFilter.Mode="Hex"
                                 Text="{Binding WifiSecureHashKey, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FieldState.HasError="{Binding HasWifiKeyError}"
                                 Visibility="{Binding ShowWifiKey, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Wi-Fi/LAN secure hash key" />
                    </Grid>
                    <Button Grid.Column="1"
                            Style="{StaticResource OutlinedButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleWifiKeyCommand}"
                            Content="{Binding WifiKeyToggleText}"
                            AutomationProperties.Name="Show or hide the Wi-Fi/LAN key" />
                </Grid>
                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding WifiKeyError}"
                           Visibility="{Binding HasWifiKeyError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Web Service. -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}"
                           Text="Web Service settings"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="0,4,0,8"
                           Text="Target environment and signing key for Web Service ECR (JSON body HMAC)." />

                <StackPanel Margin="0,0,0,12" AutomationProperties.Name="Environment">
                    <RadioButton GroupName="Environment" Content="SIT" Margin="0,2"
                                 IsChecked="{Binding Environment, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=SIT}" />
                    <RadioButton GroupName="Environment" Content="UAT" Margin="0,2"
                                 IsChecked="{Binding Environment, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=UAT}" />
                    <RadioButton GroupName="Environment" Content="PROD" Margin="0,2"
                                 IsChecked="{Binding Environment, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter=PROD}" />
                </StackPanel>

                <Label Content="Web Service secure hash k_ey" Target="{Binding ElementName=WebKeyMasked}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="WebKeyMasked"
                                     Style="{StaticResource FieldPasswordBox}"
                                     ui:PasswordBoxBinding.Filter="Hex"
                                     ui:PasswordBoxBinding.BoundPassword="{Binding WebServiceSecureHashKey, Mode=TwoWay}"
                                     ui:FieldState.HasError="{Binding HasWebServiceKeyError}"
                                     Visibility="{Binding ShowWebServiceKey, Converter={StaticResource InverseBoolToVisibility}}"
                                     AutomationProperties.Name="Web Service secure hash key" />
                        <TextBox x:Name="WebKeyPlain"
                                 Style="{StaticResource FieldTextBox}"
                                 FontFamily="Consolas"
                                 ui:TextFilter.Mode="Hex"
                                 Text="{Binding WebServiceSecureHashKey, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FieldState.HasError="{Binding HasWebServiceKeyError}"
                                 Visibility="{Binding ShowWebServiceKey, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Web Service secure hash key" />
                    </Grid>
                    <Button Grid.Column="1"
                            Style="{StaticResource OutlinedButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleWebServiceKeyCommand}"
                            Content="{Binding WebServiceKeyToggleText}"
                            AutomationProperties.Name="Show or hide the Web Service key" />
                </Grid>
                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding WebServiceKeyError}"
                           Visibility="{Binding HasWebServiceKeyError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="4,8,0,0"
                   Text="Keys are stored encrypted with Windows DPAPI, readable only by this Windows user." />
    </StackPanel>
</UserControl>
