<UserControl x:Class="AmwalECR.Example.Views.TerminalConfigCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <!--
        DataContext: SelectedTerminalConfig. What the SDK plan says about the selected
        terminal - mode, which signing key applies, where it connects, and everything
        that is missing - shown before the operator starts, not after a failure.
    -->
    <Border Padding="12" CornerRadius="12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReady}" Value="False">
                        <Setter Property="Background" Value="{StaticResource ErrorContainerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleText}"
                       FontSize="14"
                       Text="Active terminal config"
                       AutomationProperties.HeadingLevel="Level2" />

            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0">
                <Run Text="ECR mode: " /><Run Text="{Binding ModeLabel, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                <Run Text="Transport: " /><Run Text="{Binding TransportLabel, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                <Run Text="Connection: " /><Run Text="{Binding ConnectionSummary, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                <Run Text="{Binding HashKeyLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding HashKeyStatus, Mode=OneWay}" />
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Issues}"
                          IsTabStop="False"
                          Margin="0,6,0,0"
                          Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"
                                   Text="{Binding Mode=OneWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
