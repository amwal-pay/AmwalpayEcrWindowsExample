<Window x:Class="AmwalECR.Example.Views.ResultDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Headline}"
        Width="500"
        SizeToContent="Height"
        MinHeight="300"
        MaxHeight="780"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource OnSurfaceBrush}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
        DataContext: ResultDialogViewModel - the port of TransactionResultDialog.
        Approved / declined at a glance, the fields a cashier reads, the terminal's
        answer for when it does not add up, and after an inquiry the e-receipt QR.
        Enter or Escape closes it.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,8,0">

                <!-- Outcome icon and headline. Decorative: the headline says the same in words. -->
                <Path Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"
                      Data="{StaticResource CheckCircleGeometry}"
                      Fill="{StaticResource ApprovedGreenBrush}"
                      Visibility="{Binding IsApproved, Converter={StaticResource BoolToVisibility}}" />
                <Path Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"
                      Data="{StaticResource CancelCircleGeometry}"
                      Fill="{StaticResource DeclinedRedBrush}"
                      Visibility="{Binding IsDeclined, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding Headline}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           AutomationProperties.HeadingLevel="Level1"
                           AutomationProperties.LiveSetting="Assertive">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HeadlineText}">
                            <Setter Property="Foreground" Value="{StaticResource DeclinedRedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ApprovedGreenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Amount, with the Omani Rial symbol. -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasAmount, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource OmrSymbol}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource TitleText}"
                               FontSize="22"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Amount}" />
                </StackPanel>

                <TextBlock Style="{StaticResource BodyText}"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Text="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Style="{StaticResource CaptionText}"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           Text="{Binding Note}"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />

                <!-- What a till needs to recognise the transaction. -->
                <ItemsControl ItemsSource="{Binding Fields}"
                              IsTabStop="False"
                              Margin="0,16,0,0"
                              Visibility="{Binding HasFields, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" TextAlignment="Right" Margin="16,0,0,0" Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Can-void / can-refund hints from an inquiry. -->
                <ItemsControl ItemsSource="{Binding Hints}"
                              IsTabStop="False"
                              Margin="0,8,0,0"
                              Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,1" Text="{Binding Mode=OneWay, StringFormat=&#x2022; {0}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Unknown outcome: the request went out and no answer came back, so the
                    transaction may have completed. Looking it up by its reference is the
                    only action offered; there is deliberately no retry.
                -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding IsUnknownOutcome, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               Text="{Binding UnknownOutcomeWarning}" />
                    <Button Style="{StaticResource OutlinedButton}"
                            Content="_Inquire by reference"
                            Command="{Binding InquireByReferenceCommand}"
                            Margin="0,12,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource MonoText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding InquirableReference}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource TextButton}"
                                Content="Copy"
                                Command="{Binding CopyReferenceCommand}"
                                AutomationProperties.Name="Copy reference" />
                    </Grid>
                </StackPanel>

                <!-- E-receipt: a button until it is asked for, then the QR itself. -->
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource OutlinedButton}"
                            Content="_QR receipt"
                            Command="{Binding RequestReceiptCommand}"
                            Visibility="{Binding ShowReceiptButton, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ReceiptFetching, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="6" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="12,0,0,0"
                                   Text="Fetching the receipt&#x2026;"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasReceiptQr, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center" Text="Scan for the receipt" />
                        <Border Background="{StaticResource WhiteBrush}"
                                BorderBrush="{StaticResource OutlineVariantBrush}"
                                BorderThickness="1"
                                Margin="0,8,0,0"
                                Padding="4">
                            <Image Width="200" Height="200"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Source="{Binding ReceiptUrl, Converter={StaticResource QrCode}, Mode=OneWay}"
                                   AutomationProperties.Name="Receipt QR code" />
                        </Border>
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 MinHeight="28"
                                 Width="216"
                                 Text="{Binding ReceiptUrl, Mode=OneWay}"
                                 AutomationProperties.Name="Receipt link" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource ErrorText}"
                               TextAlignment="Center"
                               MaxWidth="400"
                               Text="{Binding ReceiptProblem}"
                               Visibility="{Binding HasReceiptProblem, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               TextAlignment="Center"
                               MaxWidth="400"
                               Text="{Binding ReceiptNote}"
                               Visibility="{Binding HasReceiptNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- The terminal's full answer, for when the summary does not add up. -->
                <Expander Margin="0,16,0,0"
                          Visibility="{Binding HasRawPayload, Converter={StaticResource BoolToVisibility}}">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Header" Value="Show raw response" />
                            <Style.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter Property="Header" Value="Hide raw response" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <StackPanel Margin="0,8,0,0">
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 MaxHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding RawPayload, Mode=OneWay}"
                                 AutomationProperties.Name="Raw response" />
                        <Button Style="{StaticResource TextButton}"
                                Content="Copy raw JSON"
                                Command="{Binding CopyRawCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>

                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           Text="{Binding CopyStatus}"
                           Visibility="{Binding CopyStatus, Converter={StaticResource StringToVisibility}}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="1"
                Style="{StaticResource PrimaryButton}"
                Content="_Close"
                Command="{Binding CloseCommand}"
                IsDefault="True"
                HorizontalAlignment="Right"
                MinHeight="40"
                MinWidth="96"
                Margin="0,16,0,0" />
    </Grid>
</Window>
