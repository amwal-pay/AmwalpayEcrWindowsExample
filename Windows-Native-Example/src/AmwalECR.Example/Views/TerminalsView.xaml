<UserControl x:Class="AmwalECR.Example.Views.TerminalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AmwalECR.Example.Views">
    <!-- DataContext: TerminalsViewModel. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="640" Margin="16" HorizontalAlignment="Stretch">

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,12"
                    Background="{StaticResource ErrorContainerBrush}"
                    Visibility="{Binding Notice, Converter={StaticResource StringToVisibility}}">
                <TextBlock Style="{StaticResource BodyText}"
                           Foreground="{StaticResource ErrorBrush}"
                           Text="{Binding Notice}"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>

            <views:SettingsView DataContext="{Binding Settings}" Margin="0,0,0,24" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource TitleText}"
                           Text="Registered terminals"
                           VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="40"
                        Content="_Add terminal"
                        Command="{Binding AddCommand}" />
            </Grid>

            <TextBlock Style="{StaticResource BodyText}"
                       TextAlignment="Center"
                       Margin="0,24"
                       Text="No terminals yet.&#10;Click &#x201C;Add terminal&#x201D; to register a POS terminal."
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Terminals}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource BrandBlueBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"
                                           Text="{Binding ModeLabel}" />
                                <TextBlock Style="{StaticResource MonoText}"
                                           Margin="0,4,0,0"
                                           Text="{Binding SerialNumber, StringFormat=S/N {0}}" />
                                <TextBlock Style="{StaticResource MonoText}"
                                           Margin="0,2,0,0"
                                           Text="{Binding ConnectionText}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Style="{StaticResource TextButton}"
                                            Content="Edit"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=views:TerminalsView}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}" />
                                    <Button Style="{StaticResource DangerTextButton}"
                                            Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=views:TerminalsView}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
