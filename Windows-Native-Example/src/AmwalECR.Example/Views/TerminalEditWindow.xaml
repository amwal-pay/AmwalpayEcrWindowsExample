<Window x:Class="AmwalECR.Example.Views.TerminalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AmwalECR.Example.Ui.Behaviors"
        Title="{Binding Title}"
        Width="520"
        SizeToContent="Height"
        MaxHeight="760"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource OnSurfaceBrush}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- DataContext: TerminalEditViewModel. Enter saves, Escape cancels. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,24,24,8">

                <StackPanel Margin="0,0,0,16">
                    <Label Content="Terminal _name" Target="{Binding ElementName=NameBox}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource FieldTextBox}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ui:FieldState.HasError="{Binding HasNameError}" />
                    <TextBlock Style="{StaticResource ErrorText}"
                               Text="{Binding NameError}"
                               Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <Label Content="_Serial number" Target="{Binding ElementName=SerialBox}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SerialBox"
                             Style="{StaticResource FieldTextBox}"
                             Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}"
                             ui:FieldState.HasError="{Binding HasSerialError}" />
                    <TextBlock Style="{StaticResource ErrorText}"
                               Text="{Binding SerialError}"
                               Visibility="{Binding HasSerialError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- ECR mode. USB cable and Bluetooth stay selectable, so a terminal list can match the Android one, but cannot run transactions here. -->
                <StackPanel Margin="0,0,0,8" x:Name="ModeGroup">
                    <TextBlock Style="{StaticResource TitleText}"
                               FontSize="14"
                               Text="ECR mode"
                               Margin="0,0,0,4"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{Binding ModeOptions}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <RadioButton GroupName="EcrMode"
                                                 Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.HelpText="{Binding Hint}" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Margin="22,0,0,0"
                                               Text="{Binding Hint}"
                                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Wi-Fi: address and port. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,0,8">
                        <Label Content="_IP address" Target="{Binding ElementName=IpBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="IpBox"
                                 Style="{StaticResource FieldTextBox}"
                                 ui:TextFilter.Mode="DigitsAndDots"
                                 Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FieldState.HasError="{Binding HasIpError}" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding IpError}"
                                   Visibility="{Binding HasIpError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="2,0,0,16"
                               Text="Use the IP shown on the POS terminal under the card logos. Default port is 9100. On the same PC (fake_pos_server), try 127.0.0.1." />
                    <StackPanel Margin="0,0,0,8">
                        <Label Content="_Port" Target="{Binding ElementName=PortBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PortBox"
                                 Style="{StaticResource FieldTextBox}"
                                 MaxLength="5"
                                 ui:TextFilter.Mode="Digits"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FieldState.HasError="{Binding HasPortError}"
                                 AutomationProperties.HelpText="Optional. Blank means 9100" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding PortError}"
                                   Visibility="{Binding HasPortError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="2,4,0,0"
                                   Text="Optional. Blank means 9100." />
                    </StackPanel>
                </StackPanel>

                <!-- Web Service: backend ids. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsWebService, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="_Merchant ID" Target="{Binding ElementName=MerchantIdBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MerchantIdBox"
                                 Style="{StaticResource FieldTextBox}"
                                 ui:TextFilter.Mode="Digits"
                                 Text="{Binding MerchantId, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FieldState.HasError="{Binding HasMerchantIdError}" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding MerchantIdError}"
                                   Visibility="{Binding HasMerchantIdError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <Label Content="Terminal I_D" Target="{Binding ElementName=TerminalIdBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TerminalIdBox"
                                 Style="{StaticResource FieldTextBox}"
                                 ui:TextFilter.Mode="Digits"
                                 Text="{Binding TerminalId, UpdateSourceTrigger=PropertyChanged}"
                                 ui:FieldState.HasError="{Binding HasTerminalIdError}" />
                        <TextBlock Style="{StaticResource ErrorText}"
                                   Text="{Binding TerminalIdError}"
                                   Visibility="{Binding HasTerminalIdError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="2,8,0,0"
                           Text="There is no address to enter for a USB cable: it is found when it is plugged in. The Windows SDK ships no USB channel, so this sample cannot run transactions over it."
                           Visibility="{Binding IsUsbCable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="2,8,0,0"
                           Text="Bluetooth ECR cannot be exercised from this sample."
                           Visibility="{Binding IsBluetooth, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,8,24,24">
            <Button Style="{StaticResource OutlinedButton}"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="96"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Save"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"
                    MinHeight="40"
                    MinWidth="96" />
        </StackPanel>
    </Grid>
</Window>
