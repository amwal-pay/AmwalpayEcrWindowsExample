<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Android sample's palette (res/values/colors.xml, ui/theme/Theme.kt):
        brand_blue, approved_green, declined_red and white. Everything else is the
        Material 3 light scheme those colours sit in on Android, so the two apps
        read alike.
    -->
    <Color x:Key="BrandBlueColor">#0B5FFF</Color>
    <Color x:Key="ApprovedGreenColor">#1B8A3A</Color>
    <Color x:Key="DeclinedRedColor">#C62828</Color>

    <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlueColor}" />
    <SolidColorBrush x:Key="BrandBlueHoverBrush" Color="#0A52DB" />
    <SolidColorBrush x:Key="BrandBluePressedBrush" Color="#0844B8" />
    <SolidColorBrush x:Key="ApprovedGreenBrush" Color="{StaticResource ApprovedGreenColor}" />
    <SolidColorBrush x:Key="DeclinedRedBrush" Color="{StaticResource DeclinedRedColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFBFE" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFBFE" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#E7E0EC" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#1C1B1F" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#49454F" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#79747E" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#CAC4D0" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="#FBE9E7" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#E6E1E5" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6E6A72" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0B5FFF" />

</ResourceDictionary>
