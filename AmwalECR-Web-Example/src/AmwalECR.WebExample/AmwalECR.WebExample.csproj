<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The web sample is a second front end on AmwalECR.Example.Core, the UI-free
    library the WPF sample is built on: terminal storage, settings, form
    validation, config resolution, the transaction engine, outcome classification
    and result presentation are the same code in both apps.

    Core also owns the ECR SDK switch (project | nuget), so there is nothing to
    decide here. A global property reaches Core through the ProjectReference:

      dotnet run -p:EcrSdkDependency=nuget -p:EcrSdkVersion=1.0.1
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AmwalECR.WebExample</RootNamespace>
    <AssemblyName>AmwalECR.WebExample</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Windows-Native-Example\src\AmwalECR.Example.Core\AmwalECR.Example.Core.csproj" />
    <!-- SvgQRCode: pure managed, no System.Drawing, so it runs on any OS. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
